# Keeping pyproject.toml and uv.lock out of the upload forces Vercel to install
# from requirements.txt (the API-only dependency set) instead of resolving the
# full ML dependency tree, which would exceed the function size limit.
pyproject.toml
uv.lock
.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.env
ml/
pipeline/
data/
tests/
