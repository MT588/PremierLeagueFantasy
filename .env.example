# ---------------------------------------------------------------------------
# backend/.env
# ---------------------------------------------------------------------------
# Postgres connection. For Supabase copy it from Project Settings -> Connect.
# Locally the session pooler (port 5432) is fine; on Vercel use the transaction
# pooler (port 6543) because serverless can't hold pooled connections open.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plfantasy

# Comma-separated browser origins allowed to call the API. Only needed for local
# development: in production the API is served from the frontend's own domain,
# so browser requests are same-origin and never hit CORS.
CORS_ORIGINS=http://localhost:3000

# Optional regex alternative, used only if the API is ever split onto its own
# domain again, e.g. ^https://plfantasy-[a-z0-9]+-<scope>\.vercel\.app$
CORS_ORIGIN_REGEX=

# Supabase project API URL. Doubles as the JWT issuer and the JWKS host used to
# verify access tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only for older Supabase projects that still sign tokens with a shared HS256
# secret. Leave empty when the project publishes asymmetric keys at
# /auth/v1/.well-known/jwks.json (check that URL: non-empty "keys" => leave empty).
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# frontend/.env.local
# ---------------------------------------------------------------------------
# Local only. Leave this UNSET on Vercel: the browser then uses a relative
# same-origin URL and the server falls back to VERCEL_URL, so each deployment
# talks to its own API.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from Project Settings -> API Keys>
